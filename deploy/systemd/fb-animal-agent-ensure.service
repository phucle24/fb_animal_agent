[Unit]
Description=Ensure future FB Animal Agent posts with Gemini Batch API
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fb_animal_agent
EnvironmentFile=/opt/fb_animal_agent/.env
ExecStart=/opt/fb_animal_agent/venv/bin/python scripts/ensure_future_posts_batch.py

